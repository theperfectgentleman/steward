# Option A (recommended on Dokploy): separate fields — passwords with @ ! work as-is
DB_HOST=your-dokploy-postgres-internal-hostname
DB_PORT=5432
DB_USER=dbuser
DB_PASSWORD=your-password
DB_NAME=stewarddb
DB_SSLMODE=disable

# Option B: single URL (password must be URL-encoded: @ -> %40, ! -> %21)
# DATABASE_URL=postgresql://dbuser:ENCODED_PASSWORD@HOST:5432/stewarddb?sslmode=disable

# Platform Super console unlock (required to use /super and /api/super/*)
SUPER_PASSWORD=

# Optional AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_PROVIDER_ORDER=groq,gemini
AI_MAX_PROMPT_CHARS=3500
AI_MIN_REQUEST_INTERVAL_MS=4500

# Optional email (Brevo) / SMS
#
# Deliverability (avoid spam): in Brevo → Senders, Domains & Dedicated IPs
# 1. Add and verify your domain (e.g. cognatesystems.com)
# 2. Publish SPF + DKIM DNS records Brevo provides
# 3. Add DMARC: _dmarc TXT → v=DMARC1; p=none; rua=mailto:you@yourdomain.com
# 4. Set BREVO_FROM_EMAIL to an address on that verified domain (e.g. steward@…)
# 5. Prefer BREVO_REPLY_TO on the same domain (not personal Gmail/Outlook)
#
# Option A — Brevo SMTP (matches Brevo dashboard → SMTP & API → SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_USER=
BREVO_PASSWORD=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Steward
BREVO_REPLY_TO=
# Optional: override recipient for `npx tsx scripts/test-brevo-email.ts`
# BREVO_TEST_TO=
#
# Option B — Brevo REST API key (xkeysib-...) — preferred in production
# BREVO_API_KEY=
# Legacy alias: SENDINBLUE_API_KEY=
# Fallback if BREVO_FROM_* not set:
# EMAIL_FROM=Steward <noreply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Document live co-editing (Hocuspocus / Yjs) ──────────────────────────────
# Container listens on COLLAB_PORT (default 1234). Expose that port in Dokploy
# and set COLLAB_WS_URL to the public WebSocket URL browsers will use.
#
# Local Docker Compose:
#   COLLAB_WS_URL=ws://localhost:1234
# Production (TLS reverse proxy to :1234):
#   COLLAB_WS_URL=wss://collab.your-domain.com
#   — or wss://your-domain.com if you proxy /collab path to the collab port
COLLAB_PORT=1234
COLLAB_WS_URL=ws://localhost:1234
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
# Shared HMAC secret for collab auth tokens (use a long random string in production)
COLLAB_TOKEN_SECRET=change-me-to-a-long-random-secret
# DISABLE_COLLAB=1

# ── Cloudflare R2 (document file storage) ────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 API endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional path prefix (defaults to "steward" or path segment of R2_S3_API_URL)
# R2_KEY_PREFIX=steward
# R2_S3_API_URL=https://<account_id>.r2.cloudflarestorage.com/steward
# Optional public bucket URL (r2.dev or custom domain) — downloads use auth-gated API instead
# R2_PUBLIC_BASE_URL=
